#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	cargo build --release

override_dh_auto_install:
	# Install binaries
	install -D -m 755 target/release/gestosd debian/gestos/usr/bin/gestosd
	install -D -m 755 target/release/gestos debian/gestos/usr/bin/gestos
	install -D -m 755 target/release/gestos-input debian/gestos/usr/libexec/gestos-input

	# Install the input service
	install -D -m 644 build-aux/gestos-input.socket debian/gestos/lib/systemd/system/gestos-input.socket
	install -d debian/gestos/lib/systemd/system
	sed 's,@libexecdir@,/usr/libexec,' build-aux/gestos-input@.service.in > debian/gestos/lib/systemd/system/gestos-input@.service

	# Keep old autostart entries and scripts working after the rename from MyGestures
	sed 's,@bindir@,/usr/bin,' build-aux/mygestures-compat.sh.in > debian/gestos/usr/bin/mygestures
	chmod 755 debian/gestos/usr/bin/mygestures

	# Install udev rules
	install -D -m 644 packaging/99-gestos.rules debian/gestos/lib/udev/rules.d/99-gestos.rules

	# Install systemd modules-load configuration
	install -D -m 644 packaging/gestos.conf debian/gestos/lib/modules-load.d/gestos.conf

	# Install desktop application shortcut, icon, and default configuration
	install -D -m 644 gestos.desktop debian/gestos/usr/share/applications/gestos.desktop
	install -D -m 644 gestos.svg debian/gestos/usr/share/icons/hicolor/scalable/apps/gestos.svg
	for size in 16 24 32 48 64 128 256 512; do \
		install -D -m 644 icons/gestos-$$size.png debian/gestos/usr/share/icons/hicolor/$${size}x$$size/apps/gestos.png; \
	done
	install -D -m 644 gestos.yaml debian/gestos/usr/share/gestos/gestos.yaml

	# Install the GNOME Shell extension
	install -D -m 644 extension/extension.js debian/gestos/usr/share/gnome-shell/extensions/gestos@deters.github.io/extension.js
	sh extension/fingerprint.sh debian/gestos/usr/share/gnome-shell/extensions/gestos@deters.github.io/metadata.json
	install -D -m 644 extension/prefs.js debian/gestos/usr/share/gnome-shell/extensions/gestos@deters.github.io/prefs.js
	install -D -m 644 extension/lib/tile.js debian/gestos/usr/share/gnome-shell/extensions/gestos@deters.github.io/lib/tile.js
	install -D -m 644 extension/lib/chooser.js debian/gestos/usr/share/gnome-shell/extensions/gestos@deters.github.io/lib/chooser.js
	install -D -m 644 extension/lib/trail.js debian/gestos/usr/share/gnome-shell/extensions/gestos@deters.github.io/lib/trail.js
	install -D -m 644 extension/schemas/org.gnome.shell.extensions.gestos.gschema.xml debian/gestos/usr/share/gnome-shell/extensions/gestos@deters.github.io/schemas/org.gnome.shell.extensions.gestos.gschema.xml
	glib-compile-schemas debian/gestos/usr/share/gnome-shell/extensions/gestos@deters.github.io/schemas

