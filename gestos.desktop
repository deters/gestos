[Desktop Entry]
Type=Application
Name=Gestos
Comment=Configure Gestos Mouse Gestures
Exec=gestos
Icon=gestos
Terminal=false
Categories=Settings;GTK;Utility;
StartupNotify=true
# The app ID, which the window has, so GNOME shows it as this app.
StartupWMClass=io.github.deters.Gestos
Actions=Start;Stop;

[Desktop Action Start]
Name=Start Gestures
Exec=gestos --start

[Desktop Action Stop]
Name=Stop Gestures
Exec=gestos --stop
