[Desktop Entry]
Type=Application
Name=Gestos
Comment=Configure Gestos Mouse Gestures
Exec=gestos
Icon=gestos
Terminal=false
Categories=Settings;GTK;Utility;
StartupNotify=true
Actions=Start;Stop;

[Desktop Action Start]
Name=Start Gestures
Exec=gestos --start

[Desktop Action Stop]
Name=Stop Gestures
Exec=gestos --stop
