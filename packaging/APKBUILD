# Contributor: Lucas Augusto Deters <lucasdeters@gmail.com>
# Maintainer: Lucas Augusto Deters <lucasdeters@gmail.com>
pkgname=gestos
pkgver=6.1.0
pkgrel=0
pkgdesc="Pure Wayland/Evdev mouse gestures for Linux"
url="https://github.com/deters/gestos"
arch="all"
license="GPL-2.0-or-later"
depends="gtk4.0 libevdev"
makedepends="meson ninja cargo rust gtk4.0-dev libevdev-dev pkgconfig"
replaces="mygestures"
provides="mygestures=$pkgver-r$pkgrel"
install="$pkgname.pre-install $pkgname.post-install"
subpackages=""
options="suid !check"
source="$pkgname-$pkgver.tar.gz::https://github.com/deters/gestos/archive/v$pkgver.tar.gz"

build() {
	abuild-meson . build
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install -C build

	# OpenRC starts the input service here, not systemd
	install -Dm755 packaging/gestos-input.initd "$pkgdir"/etc/init.d/gestos-input
}
